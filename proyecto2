#include <iostream>
#include <string>
#include <vector>
#include <climits>

using namespace std;

struct Alumno {string nombre; string matricula; float  calif[3]; int grupo;};
struct Maestro{string nombre; string materia; int grupo;};
struct Grupo {string nombre; string carrera;};    
float promedioDe(const Alumno& a) {
    return (a.calif[0] + a.calif[1] + a.calif[2]) / 3;
} 

int leerEntero(string mensaje, int min, int max= INT_MAX) {
    int valor;
    while (true) {
        cout << mensaje;
        if (cin >> valor && valor >= min && valor <= max) {
            cin.ignore(1000, '\n');
            return valor;
        }
        cin.clear();               
        cin.ignore(1000, '\n');   
        cout << "Dato invalido. debe ser un numero entre " << min << " y " << max << "." << endl;
    }
}

float leerFloat(string mensaje, float min, float max) {
    float valor;
    while (true) {
        cout << mensaje;
        if (cin >> valor && valor >= min && valor <= max) {
            cin.ignore(1000, '\n');
            return valor;
        }
        cin.clear();
        cin.ignore(1000, '\n');
        cout << "Dato invalido. Debe ser un numero entre " << min << " y " << max << "." << endl;
    }
}


